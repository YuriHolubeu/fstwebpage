# Copy to .env.local for local dev. Never commit .env.local.

# Django API — forms + Stripe test checkout (optional fallback)
# Local: http://127.0.0.1:8000
# Prod default: https://api.focusstructure.com (set in src/constants/site.js)
# Override here for local dev or staging:
VITE_API_BASE_URL=

# Gumroad — real founder pre-order payments (recommended until Stripe Live)
# Product URL from Gumroad → Share → copy link (use canonical permalink, not short redirect)
# Optional override; default is set in src/constants/site.js (preorder.gumroadUrl)
# Example: https://structfocus.gumroad.com/l/focus-preorder
VITE_GUMROAD_PREORDER_URL=
# Short product id from Gumroad (if different from permalink in the URL path)
VITE_GUMROAD_PRODUCT_CODE=
# Listed price in cents (700 = $7)
VITE_GUMROAD_PREORDER_PRICE_CENTS=700
